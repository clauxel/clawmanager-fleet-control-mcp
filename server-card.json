{
  "name": "clawmanagerfleet",
  "title": "ClawManager Fleet Control",
  "description": "A paid remote MCP for ClawManager, built to return verdicts, receipts, usage logs, and audit-ready JSON for agent and CI workflows.",
  "version": "1.0.0",
  "websiteUrl": "https://clawmanagerfleet.clauxel.com/",
  "documentationUrl": "https://clawmanagerfleet.clauxel.com/mcp/",
  "endpointUrl": "https://clawmanagerfleet.clauxel.com/mcp",
  "transport": "streamable-http",
  "authentication": {
    "type": "bearer",
    "required": true,
    "header": "Authorization",
    "format": "Bearer <paid-token>"
  },
  "paidAccess": {
    "required": true,
    "checkoutUrl": "https://clawmanagerfleet.clauxel.com/api/agent-checkout",
    "tokenStatusUrl": "https://clawmanagerfleet.clauxel.com/api/mcp-token/status",
    "tokenClaimUrl": "https://clawmanagerfleet.clauxel.com/api/mcp-token/claim",
    "defaultPlan": "team",
    "pricing": [
      {
        "id": "builder",
        "name": "Builder",
        "monthlyUsd": 79
      },
      {
        "id": "team",
        "name": "Team",
        "monthlyUsd": 249
      },
      {
        "id": "platform",
        "name": "Platform",
        "monthlyUsd": 799
      }
    ]
  },
  "tools": [
    {
      "name": "request_agent_instance",
      "description": "ClawManager Fleet Control request agent instance",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sample": {
            "type": "string",
            "description": "Workflow sample, schema, policy fixture, or agent output."
          },
          "context": {
            "type": "string",
            "description": "Optional review context."
          }
        },
        "required": [
          "sample"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "receipt_id": {
            "type": "string"
          },
          "usage_units": {
            "type": "integer"
          },
          "next_action": {
            "type": "string"
          }
        }
      }
    },
